<header>
  <nav>
    <a href="/" class={currentPath === "" ? "active" : ""} aria-label="home"
      >samuel</a
    >
    <a
      href="/work"
      class={currentPath === "work" ? "active" : ""}
      aria-label="work">work</a
    >
    <a
      href="/about"
      class={currentPath === "about" ? "active" : ""}
      aria-label="about">about</a
    >
    <a
      href="/now"
      class={currentPath === "now" ? "active" : ""}
      aria-label="now">now</a
    >
    <a href="/" class="earth" aria-label="world"><span>world</span></a>
    <a href="/" aria-label="dark mode">night</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 20px;
    overflow: hidden;
  }

  nav {
    display: flex;
    width: fit-content;
    padding: var(--space-10) var(--space-12);
    margin-bottom: var(--space-20);
    background-color: hsla(0, 0%, 100%, 0.5);
    border: 1px solid var(--color-lightestgray);
    border-radius: 8px;
    -webkit-box-shadow: 0px 3px 4px 0px rgba(0, 0, 0, 0.05);
    box-shadow: 0px 3px 4px 0px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(8px);
  }

  a {
    font-weight: 400;
    color: var(--color-lightgray);
    line-height: 1;
    margin-right: var(--space-16);
  }

  .active {
    color: var(--color-black);
  }

  .earth {
    font-weight: 400;
    padding-bottom: 2px;
  }

  .earth:hover {
    background-image: linear-gradient(to right, var(--gradient-earth));
    color: transparent;
    background-clip: text;
  }
</style>
