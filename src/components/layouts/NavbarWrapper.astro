---
import Navbar from "./Navbar.jsx";

const currentPath = Astro.url.pathname;

// Navigation items
const links = [
  { label: "samuel", href: "/" },
  { label: "work", href: "/work" },
  { label: "about", href: "/about" },
  { label: "now", href: "/now" },
  { label: "world", href: "/world", className: "earth" }, // change this to shwong.world or whatever the new one will become
  //{ label: "night", href: "/night" }, // probably remove and turn into a button
];
---

<header>
  <Navbar client:load links={links} path={currentPath} />
</header>
